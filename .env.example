# SQLite file location (created on first run)
DATABASE_PATH=data/sinks.db

# Optional: real sportsbook lines from https://the-odds-api.com (free tier).
# Without it, ESPN odds are used when posted, and a labeled house line otherwise.
ODDS_API_KEY=

# Optional: protects POST /api/cron/settle (call every few minutes to settle bets on a schedule)
CRON_SECRET=
